<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.member.mapper.OrderLotteryRecordMapper">
    
    <resultMap type="OrderLotteryRecord" id="OrderLotteryRecordResult">
        <result property="id"    column="id"    />
        <result property="configId"    column="config_id"    />
        <result property="userId"    column="user_id"    />
        <result property="prizeId"    column="prize_id"    />
        <result property="amount"    column="amount"    />
        <result property="createTime"    column="create_time"    />
        <result property="ipAddress"    column="ip_address"    />
        <result property="username"    column="username"    />
    </resultMap>

    <sql id="selectOrderLotteryRecordVo">
        select r.id, r.config_id, r.user_id, r.prize_id, r.amount, r.create_time, r.ip_address , u.username
        from  order_lottery_record r
        LEFT JOIN order_member_user u on u.id = r.user_id
    </sql>

    <select id="selectOrderLotteryRecordList" parameterType="OrderLotteryRecord" resultMap="OrderLotteryRecordResult">
        <include refid="selectOrderLotteryRecordVo"/>
        <where>
            <if test="username != null  and username != ''"> and u.username like concat('%', #{username}, '%')</if>
            <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
                AND date_format(r.create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
                AND date_format(r.create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
    </select>
    
    <select id="selectOrderLotteryRecordById" parameterType="Long" resultMap="OrderLotteryRecordResult">
        <include refid="selectOrderLotteryRecordVo"/>
        where id = #{id}
    </select>

    <insert id="insertOrderLotteryRecord" parameterType="OrderLotteryRecord" useGeneratedKeys="true" keyProperty="id">
        insert into order_lottery_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="configId != null">config_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="prizeId != null">prize_id,</if>
            <if test="amount != null">amount,</if>
            <if test="createTime != null">create_time,</if>
            <if test="ipAddress != null">ip_address,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="configId != null">#{configId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="prizeId != null">#{prizeId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="ipAddress != null">#{ipAddress},</if>
         </trim>
    </insert>

    <update id="updateOrderLotteryRecord" parameterType="OrderLotteryRecord">
        update order_lottery_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="configId != null">config_id = #{configId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="prizeId != null">prize_id = #{prizeId},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="ipAddress != null">ip_address = #{ipAddress},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderLotteryRecordById" parameterType="Long">
        delete from order_lottery_record where id = #{id}
    </delete>

    <delete id="deleteOrderLotteryRecordByIds" parameterType="String">
        delete from order_lottery_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
