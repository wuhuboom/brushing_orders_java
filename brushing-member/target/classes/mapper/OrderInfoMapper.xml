<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.member.mapper.OrderInfoMapper">
    
    <resultMap type="OrderInfo" id="OrderInfoResult">
        <result property="id"    column="id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="userId"    column="user_id"    />
        <result property="seriesId"    column="series_id"    />
        <result property="productId"    column="product_id"    />
        <result property="quantity"    column="quantity"    />
        <result property="price"    column="price"    />
        <result property="commission"    column="commission"    />
        <result property="commissionRate"    column="commission_rate"    />
        <result property="commissionStatus"    column="commission_status"    />
        <result property="orderTime"    column="order_time"    />
        <result property="submitTime"    column="submit_time"    />
        <result property="orderType"    column="order_type"    />
        <result property="status"    column="status"    />
        <result property="username"    column="username"    />
        <result property="phone"    column="phone"    />
        <result property="dealCount"    column="deal_count"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <!-- 嵌套商品信息 -->
        <association property="product" javaType="OrderGoods">
            <result property="id" column="goods_id"/>
            <result property="name" column="name"/>
            <result property="coverUrl" column="cover_url"/>
            <result property="price" column="price"/>
            <result property="description" column="description"/>
            <result property="status" column="goods_status"/>
            <result property="createTime" column="goods_create_time"/>
            <result property="updateTime" column="goods_update_time"/>
        </association>
    </resultMap>

    <resultMap type="OrderInfoVo" id="OrderInfoVoRes">
        <result property="id"    column="id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="goodsName" column="name"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="price"    column="price"    />
        <result property="commission"    column="commission"    />
        <result property="createTime"    column="create_time"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectOrderInfoVo">
        SELECT
        o.id, o.order_no, o.user_id, o.product_id, o.quantity,
        o.commission, o.commission_rate, o.commission_status,
        o.order_time, o.submit_time, o.order_type, o.status,
        o.create_time, o.update_time, o.price, o.series_id,

        g.id AS goods_id, g.name, g.cover_url,  g.description,
        g.status AS goods_status,
        g.create_time AS goods_create_time, g.update_time AS goods_update_time,

        u.username,u.phone,u.deal_count

        FROM order_info o
        LEFT JOIN order_goods g ON o.product_id = g.id
        left join order_member_user u on u.id = o.user_id
    </sql>

    <select id="selectOrderInfoList" parameterType="OrderInfo" resultMap="OrderInfoResult">
        <include refid="selectOrderInfoVo"/>
        <where>
            <if test="orderNo != null  and orderNo != ''"> and o.order_no = #{orderNo}</if>
        </where>
        order by o.create_time desc
    </select>
    
    <select id="selectOrderInfoById" parameterType="Long" resultMap="OrderInfoResult">
        <include refid="selectOrderInfoVo"/>
        where o.id = #{id}
    </select>

    <select id="selectOrderInfoByCode" parameterType="String" resultMap="OrderInfoResult">
        <include refid="selectOrderInfoVo"/>
        where o.order_no = #{orderNo}
    </select>

    <select id="countUnfinishedOrders" resultType="int" parameterType="Long">
        SELECT COUNT(*)
        FROM order_info
        WHERE status != 0  and user_id = #{userId}
    </select>

    <select id="selectOrderInfoBySeries" parameterType="Long" resultMap="OrderInfoResult">
        <include refid="selectOrderInfoVo"/>
            WHERE o.status = 1 AND o.order_type = 1 AND  o.user_id = #{userId}
    </select>

    <select id="selectOrderInfosByUser" parameterType="OrderInfo" resultMap="OrderInfoVoRes">
        SELECT
        o.id, o.order_no, o.commission, o.order_type, o.status,o.create_time, o.price ,
        g.name, g.cover_url
        FROM order_info o
        LEFT JOIN order_goods g ON o.product_id = g.id
        where o.user_id = #{userId}
        <if test="status != null  and status != ''"> and o.status = #{status}</if>
        order by o.create_time desc
    </select>


    <insert id="insertOrderInfo" parameterType="OrderInfo" useGeneratedKeys="true" keyProperty="id">
        insert into order_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null and userId != 0">id,</if>
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="userId != null">user_id,</if>
            <if test="seriesId != null">series_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="quantity != null">quantity,</if>
            <if test="price != null">price,</if>
            <if test="commission != null">commission,</if>
            <if test="commissionRate != null">commission_rate,</if>
            <if test="commissionStatus != null">commission_status,</if>
            <if test="orderTime != null">order_time,</if>
            <if test="submitTime != null">submit_time,</if>
            <if test="orderType != null">order_type,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="userId != null">#{userId},</if>
            <if test="seriesId != null">#{seriesId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="price != null">#{price},</if>
            <if test="commission != null">#{commission},</if>
            <if test="commissionRate != null">#{commissionRate},</if>
            <if test="commissionStatus != null">#{commissionStatus},</if>
            <if test="orderTime != null">#{orderTime},</if>
            <if test="submitTime != null">#{submitTime},</if>
            <if test="orderType != null">#{orderType},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateOrderInfo" parameterType="OrderInfo">
        update order_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="commission != null">commission = #{commission},</if>
            <if test="commissionRate != null">commission_rate = #{commissionRate},</if>
            <if test="commissionStatus != null">commission_status = #{commissionStatus},</if>
            <if test="orderTime != null">order_time = #{orderTime},</if>
            <if test="submitTime != null">submit_time = #{submitTime},</if>
            <if test="orderType != null">order_type = #{orderType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderInfoById" parameterType="String">
        delete from order_info where id = #{id}
    </delete>

    <delete id="deleteOrderInfoByIds" parameterType="String">
        delete from order_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
