<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.member.mapper.OrderLotteryConfigMapper">
    
    <resultMap type="OrderLotteryConfig" id="OrderLotteryConfigResult">
        <result property="id"    column="id"    />
        <result property="activityName"    column="activity_name"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="totalCount"    column="total_count"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectOrderLotteryConfigVo">
        select id, activity_name, total_amount, total_count, status, create_time, update_time from order_lottery_config
    </sql>

    <select id="selectOrderLotteryConfigList" parameterType="OrderLotteryConfig" resultMap="OrderLotteryConfigResult">
        <include refid="selectOrderLotteryConfigVo"/>
        <where>  
            <if test="activityName != null  and activityName != ''"> and activity_name like concat('%', #{activityName}, '%')</if>
            <if test="totalAmount != null "> and total_amount = #{totalAmount}</if>
            <if test="totalCount != null "> and total_count = #{totalCount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectOrderLotteryConfigById" parameterType="Long" resultMap="OrderLotteryConfigResult">
        <include refid="selectOrderLotteryConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertOrderLotteryConfig" parameterType="OrderLotteryConfig" useGeneratedKeys="true" keyProperty="id">
        insert into order_lottery_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="activityName != null">activity_name,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="totalCount != null">total_count,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="activityName != null">#{activityName},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="totalCount != null">#{totalCount},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateOrderLotteryConfig" parameterType="OrderLotteryConfig">
        update order_lottery_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="activityName != null">activity_name = #{activityName},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="totalCount != null">total_count = #{totalCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderLotteryConfigById" parameterType="Long">
        delete from order_lottery_config where id = #{id}
    </delete>

    <delete id="deleteOrderLotteryConfigByIds" parameterType="String">
        delete from order_lottery_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
