<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.member.mapper.OrderSeriesMapper">
    
    <resultMap type="OrderSeries" id="OrderSeriesResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="productId"    column="product_id"    />
        <result property="price"    column="price"    />
        <result property="orderIndex"    column="order_index"    />
        <result property="commissionRatio"    column="commission_ratio"    />
        <result property="status"    column="status"    />
        <result property="type"    column="type"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="productName" column="product_name"/>
    </resultMap>

    <sql id="selectOrderSeriesVo">
        SELECT
        s.id,
        s.user_id,
        s.product_id,
        s.price,
        s.type,
        s.order_index,
        s.commission_ratio,
        s.status,
        s.type,
        s.create_by,
        s.create_time,
        g.name AS product_name
        FROM
        order_series s
        LEFT JOIN
        order_goods g
        ON
        s.product_id = g.id
    </sql>

    <select id="selectOrderSeriesList" parameterType="OrderSeries" resultMap="OrderSeriesResult">
        <include refid="selectOrderSeriesVo"/>
        <where>
            <if test="userId != null "> and s.user_id = #{userId}</if>
        </where>
        order by s.create_time desc
    </select>
    
    <select id="selectOrderSeriesById" parameterType="Long" resultMap="OrderSeriesResult">
        <include refid="selectOrderSeriesVo"/>
        where s.id = #{id}
    </select>

    <select id="selectByUserIdAndOrderIndexes" resultMap="OrderSeriesResult">
        SELECT
        id, user_id, product_id, type, price, order_index, commission_ratio, status, create_by, create_time
        FROM
        order_series
        WHERE
        user_id = #{userId}
        AND status = 1
        <if test="orderIndexList != null and orderIndexList.size() > 0">
            AND order_index IN
            <foreach collection="orderIndexList" item="idx" open="(" separator="," close=")">
                #{idx}
            </foreach>
        </if>
    </select>

    <select id="selectSeriesListByUserId" resultMap="OrderSeriesResult">
        SELECT
        id, user_id, product_id, type, price, order_index, commission_ratio, status, create_by, create_time
        FROM
        order_series
        WHERE
        user_id = #{userId}
        AND status = 1
    </select>

    <select id="selectOrderSeriesByFrozen" parameterType="Long" resultMap="OrderSeriesResult">
        <include refid="selectOrderSeriesVo"/>
        where s.user_id = #{userId} and s.status = 2
    </select>


    <insert id="insertOrderSeries" parameterType="OrderSeries" useGeneratedKeys="true" keyProperty="id">
        insert into order_series
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="price != null">price,</if>
            <if test="orderIndex != null">order_index,</if>
            <if test="commissionRatio != null">commission_ratio,</if>
            <if test="status != null">status,</if>
            <if test="type != null">type,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="price != null">#{price},</if>
            <if test="orderIndex != null">#{orderIndex},</if>
            <if test="commissionRatio != null">#{commissionRatio},</if>
            <if test="status != null">#{status},</if>
            <if test="type != null">#{type},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateOrderSeries" parameterType="OrderSeries">
        update order_series
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="price != null">price = #{price},</if>
            <if test="orderIndex != null">order_index = #{orderIndex},</if>
            <if test="status != null">status = #{status},</if>
            <if test="type != null">type = #{type},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderSeriesById" parameterType="Long">
        delete from order_series where id = #{id}
    </delete>

    <delete id="deleteOrderSeriesByIds" parameterType="String">
        delete from order_series where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
