<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.member.mapper.WelfareConfigMapper">
    
    <resultMap type="WelfareConfig" id="WelfareConfigResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="type"    column="type"    />
        <result property="remark"    column="remark"    />
        <result property="amount"    column="amount"    />
        <result property="status"    column="status"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedTime"    column="updated_time"    />
    </resultMap>

    <sql id="selectWelfareConfigVo">
        select id, name, type, remark, amount, status, created_time, updated_time from welfare_config
    </sql>

    <select id="selectWelfareConfigList" parameterType="WelfareConfig" resultMap="WelfareConfigResult">
        <include refid="selectWelfareConfigVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectWelfareConfigById" parameterType="Long" resultMap="WelfareConfigResult">
        <include refid="selectWelfareConfigVo"/>
        where id = #{id}
    </select>

    <select id="selectWelfareConfigByType" parameterType="String" resultMap="WelfareConfigResult">
        <include refid="selectWelfareConfigVo"/>
        where type = #{type}
    </select>

    <insert id="insertWelfareConfig" parameterType="WelfareConfig" useGeneratedKeys="true" keyProperty="id">
        insert into welfare_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="remark != null">remark,</if>
            <if test="amount != null">amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="updatedTime != null">updated_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="remark != null">#{remark},</if>
            <if test="amount != null">#{amount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="updatedTime != null">#{updatedTime},</if>
         </trim>
    </insert>

    <update id="updateWelfareConfig" parameterType="WelfareConfig">
        update welfare_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createdTime != null">created_time = #{createdTime},</if>
            <if test="updatedTime != null">updated_time = #{updatedTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWelfareConfigById" parameterType="Long">
        delete from welfare_config where id = #{id}
    </delete>

    <delete id="deleteWelfareConfigByIds" parameterType="String">
        delete from welfare_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
