<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.member.mapper.OrderShopMapper">
    
    <resultMap type="OrderShop" id="OrderShopResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="icon"    column="icon"    />
        <result property="vipLevel"    column="vip_level"    />
        <result property="autoVip"    column="auto_vip"    />
        <result property="maxAutoVip"    column="max_auto_vip"    />
        <result property="minMoney"    column="min_money"    />
        <result property="maxMoney"    column="max_money"    />
        <result property="commissionPercentage"    column="commission_percentage"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectOrderShopVo">
        select id, name, icon, vip_level, auto_vip, min_money,max_auto_vip,
               max_money, commission_percentage, remark, create_time, update_time from order_shop
    </sql>

    <select id="selectOrderShopList" parameterType="OrderShop" resultMap="OrderShopResult">
        <include refid="selectOrderShopVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="icon != null  and icon != ''"> and icon = #{icon}</if>
            <if test="vipLevel != null "> and vip_level = #{vipLevel}</if>
            <if test="minMoney != null "> and min_money = #{minMoney}</if>
            <if test="maxMoney != null "> and max_money = #{maxMoney}</if>
            <if test="commissionPercentage != null "> and commission_percentage = #{commissionPercentage}</if>
        </where>
    </select>
    
    <select id="selectOrderShopById" parameterType="Long" resultMap="OrderShopResult">
        <include refid="selectOrderShopVo"/>
        where id = #{id}
    </select>

    <select id="selectOrderShopByVipLevel" parameterType="Integer" resultMap="OrderShopResult">
        <include refid="selectOrderShopVo"/>
        where vip_level = #{vipLevel}
    </select>

  <select id="selectOrderShopByAutoVip" parameterType="Integer" resultMap="OrderShopResult">
      SELECT id, name, icon, vip_level, auto_vip, max_auto_vip, min_money, max_money, commission_percentage, remark, create_time, update_time
      FROM order_shop
      WHERE #{autoVip} BETWEEN auto_vip AND max_auto_vip
      ORDER BY vip_level DESC
      LIMIT 1
    </select>

    <select id="findByVipLevel" resultMap="OrderShopResult">
        SELECT * FROM order_shop
        WHERE vip_level &lt;= #{vipLevel}
    </select>

    <insert id="insertOrderShop" parameterType="OrderShop" useGeneratedKeys="true" keyProperty="id">
        insert into order_shop
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="icon != null">icon,</if>
            <if test="vipLevel != null">vip_level,</if>
            <if test="autoVip != null">auto_vip,</if>
            <if test="maxAutoVip != null">max_auto_vip,</if>
            <if test="minMoney != null">min_money,</if>
            <if test="maxMoney != null">max_money,</if>
            <if test="commissionPercentage != null">commission_percentage,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="icon != null">#{icon},</if>
            <if test="vipLevel != null">#{vipLevel},</if>
            <if test="autoVip != null">#{autoVip},</if>
            <if test="maxAutoVip != null">#{maxAutoVip},</if>
            <if test="minMoney != null">#{minMoney},</if>
            <if test="maxMoney != null">#{maxMoney},</if>
            <if test="commissionPercentage != null">#{commissionPercentage},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateOrderShop" parameterType="OrderShop">
        update order_shop
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="vipLevel != null">vip_level = #{vipLevel},</if>
            <if test="autoVip != null">auto_vip = #{autoVip},</if>
            <if test="maxAutoVip != null">max_auto_vip = #{maxAutoVip},</if>
            <if test="minMoney != null">min_money = #{minMoney},</if>
            <if test="maxMoney != null">max_money = #{maxMoney},</if>
            <if test="commissionPercentage != null">commission_percentage = #{commissionPercentage},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderShopById" parameterType="Long">
        delete from order_shop where id = #{id}
    </delete>

    <delete id="deleteOrderShopByIds" parameterType="String">
        delete from order_shop where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
