<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.member.mapper.OrderUserLoginLogMapper">

    <resultMap type="OrderUserLoginLog" id="OrderUserLoginLogResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="username" column="username" />
        <result property="ip"    column="ip"    />
        <result property="location"    column="location"    />
        <result property="loginDomain"    column="login_domain"    />
        <result property="browser"    column="browser"    />
        <result property="os"    column="os"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectOrderUserLoginLogVo">
        select l.id, l.user_id, u.username, l.ip, l.location, l.login_domain, l.browser, l.os, l.status, l.create_time
        from order_user_login_log l
        left join order_member_user u on u.id = l.user_id
    </sql>

    <select id="selectOrderUserLoginLogList" parameterType="OrderUserLoginLog" resultMap="OrderUserLoginLogResult">
        <include refid="selectOrderUserLoginLogVo"/>
        <where>
            <if test="username != null "> and u.username = #{username}</if>
            <if test="userId != null "> and l.user_id = #{userId}</if>
            <if test="ip != null  and ip != ''"> and l.ip = #{ip}</if>
            <if test="location != null  and location != ''"> and l.location = #{location}</if>
            <if test="loginDomain != null  and loginDomain != ''"> and l.login_domain = #{loginDomain}</if>
            <if test="browser != null  and browser != ''"> and l.browser = #{browser}</if>
            <if test="os != null  and os != ''"> and l.os = #{os}</if>
            <if test="status != null  and status != ''"> and l.status = #{status}</if>
        </where>
    </select>

    <select id="selectOrderUserLoginLogById" parameterType="Long" resultMap="OrderUserLoginLogResult">
        <include refid="selectOrderUserLoginLogVo"/>
        where l.id = #{id}
    </select>

    <insert id="insertOrderUserLoginLog" parameterType="OrderUserLoginLog" useGeneratedKeys="true" keyProperty="id">
        insert into order_user_login_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="ip != null and ip != ''">ip,</if>
            <if test="location != null">location,</if>
            <if test="loginDomain != null">login_domain,</if>
            <if test="browser != null">browser,</if>
            <if test="os != null">os,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="ip != null and ip != ''">#{ip},</if>
            <if test="location != null">#{location},</if>
            <if test="loginDomain != null">#{loginDomain},</if>
            <if test="browser != null">#{browser},</if>
            <if test="os != null">#{os},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateOrderUserLoginLog" parameterType="OrderUserLoginLog">
        update order_user_login_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="ip != null and ip != ''">ip = #{ip},</if>
            <if test="location != null">location = #{location},</if>
            <if test="loginDomain != null">login_domain = #{loginDomain},</if>
            <if test="browser != null">browser = #{browser},</if>
            <if test="os != null">os = #{os},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderUserLoginLogById" parameterType="Long">
        delete from order_user_login_log where id = #{id}
    </delete>

    <delete id="deleteOrderUserLoginLogByIds" parameterType="String">
        delete from order_user_login_log where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
