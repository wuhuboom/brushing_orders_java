<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.member.mapper.OrderAccountChangeMapper">
    
    <resultMap type="OrderAccountChange" id="OrderAccountChangeResult">
        <result property="id"    column="id"    />
        <result property="changeNo"    column="change_no"    />
        <result property="userId"    column="user_id"    />
        <result property="type"    column="type"    />
        <result property="beforeAmount"    column="before_amount"    />
        <result property="changeAmount"    column="change_amount"    />
        <result property="afterAmount"    column="after_amount"    />
        <result property="description"    column="description"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectOrderAccountChangeVo">
        select id, change_no, user_id, type, before_amount, change_amount, after_amount, description, create_time from order_account_change
    </sql>

    <select id="selectOrderAccountChangeList" parameterType="OrderAccountChange" resultMap="OrderAccountChangeResult">
        <include refid="selectOrderAccountChangeVo"/>
        <where>  
            <if test="changeNo != null  and changeNo != ''"> and change_no = #{changeNo}</if>
            <if test="userId != null  and userId != ''"> and user_id = #{userId}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="beforeAmount != null "> and before_amount = #{beforeAmount}</if>
            <if test="changeAmount != null "> and change_amount = #{changeAmount}</if>
            <if test="afterAmount != null "> and after_amount = #{afterAmount}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
        </where>
    </select>
    
    <select id="selectOrderAccountChangeById" parameterType="Long" resultMap="OrderAccountChangeResult">
        <include refid="selectOrderAccountChangeVo"/>
        where id = #{id}
    </select>

    <select id="selectOrderAccountChangeByCode" parameterType="String" resultMap="OrderAccountChangeResult">
        <include refid="selectOrderAccountChangeVo"/>
        where change_no = #{changeNo}
    </select>

    <insert id="insertOrderAccountChange" parameterType="OrderAccountChange" useGeneratedKeys="true" keyProperty="id">
        insert into order_account_change
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="changeNo != null and changeNo != ''">change_no,</if>
            <if test="userId != null and userId != ''">user_id,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="beforeAmount != null">before_amount,</if>
            <if test="changeAmount != null">change_amount,</if>
            <if test="afterAmount != null">after_amount,</if>
            <if test="description != null">description,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="changeNo != null and changeNo != ''">#{changeNo},</if>
            <if test="userId != null and userId != ''">#{userId},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="beforeAmount != null">#{beforeAmount},</if>
            <if test="changeAmount != null">#{changeAmount},</if>
            <if test="afterAmount != null">#{afterAmount},</if>
            <if test="description != null">#{description},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateOrderAccountChange" parameterType="OrderAccountChange">
        update order_account_change
        <trim prefix="SET" suffixOverrides=",">
            <if test="changeNo != null and changeNo != ''">change_no = #{changeNo},</if>
            <if test="userId != null and userId != ''">user_id = #{userId},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="beforeAmount != null">before_amount = #{beforeAmount},</if>
            <if test="changeAmount != null">change_amount = #{changeAmount},</if>
            <if test="afterAmount != null">after_amount = #{afterAmount},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderAccountChangeById" parameterType="String">
        delete from order_account_change where id = #{id}
    </delete>

    <delete id="deleteOrderAccountChangeByIds" parameterType="String">
        delete from order_account_change where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
