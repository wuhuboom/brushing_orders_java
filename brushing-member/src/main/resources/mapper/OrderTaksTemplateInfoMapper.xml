<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.member.mapper.OrderTaksTemplateInfoMapper">

    <resultMap type="OrderTaksTemplateInfo" id="OrderTaksTemplateInfoResult">
        <result property="id"    column="id"    />
        <result property="templateId"    column="template_id"    />
        <result property="templateName" column="template_name" />
        <result property="productId"    column="product_id"    />
        <result property="productName" column="product_name" />
        <result property="price"    column="price"    />
        <result property="commissionRatio"    column="commission_ratio"    />
        <result property="orderIndex"    column="order_index"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="type"    column="type"    />
    </resultMap>

    <sql id="selectOrderTaksTemplateInfoVo">
        select i.id,
               i.template_id,
               t.name as template_name,
               i.product_id,
               g.name as product_name,
               i.price,
               i.commission_ratio,
               i.order_index,
               i.status,
               i.create_by,
               i.create_time,
               i.type
        from order_taks_template_info i
        left join order_task_template t on t.id = i.template_id
        left join order_goods g on g.id = i.product_id
    </sql>

    <select id="selectOrderTaksTemplateInfoList" parameterType="OrderTaksTemplateInfo" resultMap="OrderTaksTemplateInfoResult">
        <include refid="selectOrderTaksTemplateInfoVo"/>
        <where>
            <if test="templateId != null "> and i.template_id = #{templateId}</if>
            <if test="productId != null "> and i.product_id = #{productId}</if>
            <if test="price != null "> and i.price = #{price}</if>
            <if test="commissionRatio != null "> and i.commission_ratio = #{commissionRatio}</if>
            <if test="orderIndex != null "> and i.order_index = #{orderIndex}</if>
            <if test="status != null  and status != ''"> and i.status = #{status}</if>
            <if test="type != null  and type != ''"> and i.type = #{type}</if>
        </where>
    </select>

    <select id="selectOrderTaksTemplateInfoById" parameterType="Long" resultMap="OrderTaksTemplateInfoResult">
        <include refid="selectOrderTaksTemplateInfoVo"/>
        where i.id = #{id}
    </select>

    <select id="selectOrderTaksTemplateInfoByTemplateId" parameterType="Long" resultMap="OrderTaksTemplateInfoResult">
        <include refid="selectOrderTaksTemplateInfoVo"/>
        where i.template_id = #{templateId}
    </select>

    <insert id="insertOrderTaksTemplateInfo" parameterType="OrderTaksTemplateInfo" useGeneratedKeys="true" keyProperty="id">
        insert into order_taks_template_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateId != null">template_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="price != null">price,</if>
            <if test="commissionRatio != null">commission_ratio,</if>
            <if test="orderIndex != null">order_index,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="type != null">type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateId != null">#{templateId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="price != null">#{price},</if>
            <if test="commissionRatio != null">#{commissionRatio},</if>
            <if test="orderIndex != null">#{orderIndex},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="type != null">#{type},</if>
         </trim>
    </insert>

    <update id="updateOrderTaksTemplateInfo" parameterType="OrderTaksTemplateInfo">
        update order_taks_template_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateId != null">template_id = #{templateId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="price != null">price = #{price},</if>
            <if test="commissionRatio != null">commission_ratio = #{commissionRatio},</if>
            <if test="orderIndex != null">order_index = #{orderIndex},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="type != null">type = #{type},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderTaksTemplateInfoById" parameterType="Long">
        delete from order_taks_template_info where id = #{id}
    </delete>

    <delete id="deleteOrderTaksTemplateInfoByIds" parameterType="String">
        delete from order_taks_template_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 新增：用于校验同一模板下 order_index 是否重复 -->
    <select id="countByTemplateIdAndOrderIndex" parameterType="map" resultType="int">
        select count(1) from order_taks_template_info
        where template_id = #{templateId}
        and order_index = #{orderIndex}
        <if test="excludeId != null"> and id &lt;&gt; #{excludeId}</if>
    </select>
</mapper>
