    <sql id="selectOrderMemberUserVo">
        SELECT
        u.id,
        u.username,
        u.phone,
        u.password,
        u.trade_password,
        u.parent_id,
        u.ancestors,
        u.sex,
        u.email,
        u.credit_score,
        u.balance,
        u.frozen_balance,
        u.total_balance,
        u.invite_code,
        u.register_ip,
        u.last_login_time,
        u.account_status,
        u.trade_status,
        u.withdraw_status,
        u.real_name_status,
        u.real_name,
        u.id_card_number,
        u.id_card_front,
        u.id_card_back,
        u.withdraw_name,
        u.withdraw_address,
        u.withdraw_type,
        u.create_time,
        u.remark,
        u.is_real,
        u.level_id,
        l.id AS level_id,
        l.icon,
        l.name_zh,
        l.name_en,
        l.order_count
        FROM
        order_member_user u
        LEFT JOIN
        order_member_level l ON u.level_id = l.id
    </sql>


    <select id="selectOrderMemberUserList" parameterType="OrderMemberUser" resultMap="OrderMemberUserResult">
        <include refid="selectOrderMemberUserVo"/>
        <where>  
            <if test="username != null  and username != ''"> and u.username like concat('%', #{username}, '%')</if>
            <if test="phone != null  and phone != ''"> and u.phone = #{phone}</if>
        </where>
    </select>
    
    <select id="selectOrderMemberUserById" parameterType="Long" resultMap="OrderMemberUserResult">
        <include refid="selectOrderMemberUserVo"/>
        where u.id = #{id}
    </select>

    <select id="selectOrderMemberUserByInCode" parameterType="String" resultMap="OrderMemberUserResult">
        <include refid="selectOrderMemberUserVo"/>
        where u.invite_code = #{inviteCode}
    </select>

    <select id="findByUsername" parameterType="String" resultMap="OrderMemberUserResult">
        <include refid="selectOrderMemberUserVo"/>
        where u.username = #{username}
    </select>

