<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.member.mapper.OrderFieldSettingMapper">

    <resultMap type="OrderFieldSetting" id="OrderFieldSettingResult">
        <result property="id"    column="id"    />
        <result property="tableName"    column="table_name"    />
        <result property="fieldName"    column="field_name"    />
        <result property="type"    column="type"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectOrderFieldSettingVo">
        select id, table_name, field_name, type, status, create_time from order_field_setting
    </sql>

    <select id="selectOrderFieldSettingList" parameterType="OrderFieldSetting" resultMap="OrderFieldSettingResult">
        <include refid="selectOrderFieldSettingVo"/>
        <where>
            <if test="tableName != null  and tableName != ''"> and table_name like concat('%', #{tableName}, '%')</if>
            <if test="fieldName != null  and fieldName != ''"> and field_name like concat('%', #{fieldName}, '%')</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectOrderFieldSettingById" parameterType="Long" resultMap="OrderFieldSettingResult">
        <include refid="selectOrderFieldSettingVo"/>
        where id = #{id}
    </select>

    <select id="selectOrderFieldSettingByType" parameterType="String" resultMap="OrderFieldSettingResult">
        <include refid="selectOrderFieldSettingVo"/>
        where type = #{type}
    </select>

    <insert id="insertOrderFieldSetting" parameterType="OrderFieldSetting" useGeneratedKeys="true" keyProperty="id">
        insert into order_field_setting
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tableName != null and tableName != ''">table_name,</if>
            <if test="fieldName != null and fieldName != ''">field_name,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tableName != null and tableName != ''">#{tableName},</if>
            <if test="fieldName != null and fieldName != ''">#{fieldName},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateOrderFieldSetting" parameterType="OrderFieldSetting">
        update order_field_setting
        <trim prefix="SET" suffixOverrides=",">
            <if test="tableName != null and tableName != ''">table_name = #{tableName},</if>
            <if test="fieldName != null and fieldName != ''">field_name = #{fieldName},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderFieldSettingById" parameterType="Long">
        delete from order_field_setting where id = #{id}
    </delete>

    <delete id="deleteOrderFieldSettingByIds" parameterType="String">
        delete from order_field_setting where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="checkTypeUnique" parameterType="String" resultMap="OrderFieldSettingResult">
        <include refid="selectOrderFieldSettingVo"/>
        where type = #{type} limit 1
    </select>

</mapper>
