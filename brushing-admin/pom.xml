<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程，版本号与坐标保持不变 -->
    <parent>
        <groupId>com.brushing</groupId>
        <artifactId>brushing</artifactId>
        <version>3.9.0</version>
    </parent>

    <groupId>com.brushing</groupId>
    <artifactId>brushing-admin</artifactId>
    <packaging>jar</packaging>

    <name>brushing-admin</name>
    <description>web服务入口（可执行瘦JAR，自家模块打入JAR，第三方下发到lib）</description>

    <dependencies>

        <!-- 开发时热更（不会被发到lib，因为下面显式排除） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- SpringDoc（版本由父级 spring-boot-dependencies/springdoc.version 管理） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- MySQL 驱动（第三方，最终会进入 target/lib） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- ===== 自家模块：会被 Shade 内嵌进 brushing-admin.jar ===== -->
        <dependency>
            <groupId>com.brushing</groupId>
            <artifactId>brushing-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brushing</groupId>
            <artifactId>brushing-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brushing</groupId>
            <artifactId>brushing-quartz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brushing</groupId>
            <artifactId>brushing-generator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brushing</groupId>
            <artifactId>brushing-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brushing</groupId>
            <artifactId>brushing-member</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brushing</groupId>
            <artifactId>brushing-set</artifactId>
        </dependency>
        <!-- ===== 自家模块 END ===== -->

        <!-- 其他第三方（示例：HTTP Client、WebSocket；会进入 target/lib） -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>5.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.5.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>

            <!-- 复制第三方运行时依赖到 target/lib（排除 com.brushing 与 devtools） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <excludeGroupIds>com.brushing</excludeGroupIds>
                            <excludeArtifactIds>spring-boot-devtools</excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 只打“可执行瘦JAR”，Class-Path 指向 lib/，指定 Main-Class -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>com.brushing.BrushingApplication</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- 仅“内嵌自家模块”到 brushing-admin.jar；第三方依赖不内嵌 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>${project.artifactId}</finalName>
                            <artifactSet>
                                <includes>
                                    <include>com.brushing:brushing-system</include>
                                    <include>com.brushing:brushing-framework</include>
                                    <include>com.brushing:brushing-common</include>
                                    <include>com.brushing:brushing-quartz</include>
                                    <include>com.brushing:brushing-generator</include>
                                    <include>com.brushing:brushing-member</include>
                                    <include>com.brushing:brushing-set</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- 指定可执行入口 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.brushing.BrushingApplication</mainClass>
                                </transformer>
                                <!-- 合并 Spring Boot 3 的自动配置清单 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</resource>
                                </transformer>
                                <!-- 合并 SPI 服务声明 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <!-- 如遇到包冲突再加 relocation -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 注意：不再使用 spring-boot-maven-plugin 的 repackage（避免 fat-jar） -->
            <!-- 你原先在子模块里用了 2.5.15 + repackage；这里已移除。 -->
        </plugins>
    </build>

</project>
