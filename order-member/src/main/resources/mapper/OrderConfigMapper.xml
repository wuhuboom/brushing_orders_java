<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.member.mapper.OrderConfigMapper">
    
    <resultMap type="OrderConfig" id="OrderConfigResult">
        <result property="id"    column="id"    />
        <result property="type"    column="type"    />
        <result property="sort"    column="sort"    />
        <result property="name"    column="name"    />
        <result property="content"    column="content"    />
        <result property="translationsId" column="translations_id" />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectOrderConfigVo">
        select id, type, sort, name, content, translations_id, create_time, update_time from order_config
    </sql>

    <select id="selectOrderConfigList" parameterType="OrderConfig" resultMap="OrderConfigResult">
        <include refid="selectOrderConfigVo"/>
        <where>  
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="translationsId != null"> and translations_id = #{translationsId}</if>
        </where>
    </select>


    <select id="selectOrderConfigByType" parameterType="String" resultMap="OrderConfigResult">
        <include refid="selectOrderConfigVo"/>
        where type = #{type}
    </select>

    <select id="selectOrderConfigByTypes" resultMap="OrderConfigResult">
        <include refid="selectOrderConfigVo"/>
        where type in
        <foreach item="type" collection="list" open="(" separator="," close=")">
            #{type}
        </foreach>
    </select>

    <select id="selectOrderConfigById" parameterType="Long" resultMap="OrderConfigResult">
        <include refid="selectOrderConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertOrderConfig" parameterType="OrderConfig" useGeneratedKeys="true" keyProperty="id">
        insert into order_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="type != null and type != ''">type,</if>
            <if test="sort != null">sort,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="content != null">content,</if>
            <if test="translationsId != null">translations_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="type != null and type != ''">#{type},</if>
            <if test="sort != null">#{sort},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="content != null">#{content},</if>
            <if test="translationsId != null">#{translationsId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateOrderConfig" parameterType="OrderConfig">
        update order_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="content != null">content = #{content},</if>
            <if test="translationsId != null">translations_id = #{translationsId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderConfigById" parameterType="Long">
        delete from order_config where id = #{id}
    </delete>

    <delete id="deleteOrderConfigByIds" parameterType="String">
        delete from order_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
