<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.member.mapper.OrderLinkMapper">
    
    <resultMap type="OrderLink" id="OrderLinkResult">
        <result property="id"    column="id"    />
        <result property="linkOrderId"    column="link_order_id"    />
        <result property="userId"    column="user_id"    />
        <result property="orderCount"    column="order_count"    />
        <result property="commissionMultiple"    column="commission_multiple"    />
        <result property="productId"    column="product_id"    />
        <result property="productTitle"    column="product_title"    />
        <result property="productImage"    column="product_image"    />
        <result property="priceType"    column="price_type"    />
        <result property="price"    column="price"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectOrderLinkVo">
        select ol.id, ol.link_order_id, ol.user_id, ol.order_count, ol.commission_multiple, ol.product_id, g.title as product_title, g.image as product_image, ol.price_type, ol.price, ol.status, ol.create_time
        from order_link ol
        left join goods g on g.id = ol.product_id
    </sql>

    <select id="selectOrderLinkList" parameterType="OrderLink" resultMap="OrderLinkResult">
        <include refid="selectOrderLinkVo"/>
        <where>  
            <if test="linkOrderId != null "> and ol.link_order_id = #{linkOrderId}</if>
            <if test="userId != null "> and ol.user_id = #{userId}</if>
            <if test="productId != null "> and ol.product_id = #{productId}</if>
        </where>
        order by ol.create_time desc
    </select>

    <select id="selectOrderLinkById"  resultMap="OrderLinkResult">
        <include refid="selectOrderLinkVo"/>
        where ol.id = #{id}
    </select>

    <select id="selectOrderLinkByUserId" parameterType="Long" resultMap="OrderLinkResult">
        <include refid="selectOrderLinkVo"/>
        where ol.user_id = #{userId} and ol.order_count= #{orderCount} and status = '1' order by ol.create_time asc
    </select>

    <select id="selectNextOrderLink" resultMap="OrderLinkResult">
        <include refid="selectOrderLinkVo"/>
        WHERE ol.user_id = #{userId}
          AND ol.order_count = #{orderCount}
          AND ol.status = '1'
        ORDER BY ol.create_time ASC, ol.id ASC
        LIMIT 1
        FOR UPDATE
    </select>

    <!-- 新增：获取当前最大的 link_order_id -->
    <select id="selectMaxLinkOrderId" resultType="java.lang.Long">
        select max(link_order_id) from order_link
    </select>

    <insert id="insertOrderLink" parameterType="OrderLink" useGeneratedKeys="true" keyProperty="id">
        insert into order_link
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="linkOrderId != null">link_order_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="orderCount != null">order_count,</if>
            <if test="commissionMultiple != null">commission_multiple,</if>
            <if test="productId != null">product_id,</if>
            <if test="priceType != null and priceType != ''">price_type,</if>
            <if test="price != null">price,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="linkOrderId != null">#{linkOrderId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="orderCount != null">#{orderCount},</if>
            <if test="commissionMultiple != null">#{commissionMultiple},</if>
            <if test="productId != null">#{productId},</if>
            <if test="priceType != null and priceType != ''">#{priceType},</if>
            <if test="price != null">#{price},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateOrderLink" parameterType="OrderLink">
        update order_link ol
        <trim prefix="SET" suffixOverrides=",">
            <if test="linkOrderId != null">link_order_id = #{linkOrderId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="orderCount != null">order_count = #{orderCount},</if>
            <if test="commissionMultiple != null">commission_multiple = #{commissionMultiple},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="priceType != null and priceType != ''">price_type = #{priceType},</if>
            <if test="price != null">price = #{price},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where ol.id = #{id}
          and not exists (
              select 1
              from order_info oi
              where oi.link_id = ol.id
                and oi.status = '1'
          )
    </update>

    <update id="completeOrderLink">
        UPDATE order_link
        SET status = '0'
        WHERE id = #{id}
          AND user_id = #{userId}
    </update>

    <delete id="deleteOrderLinkById" parameterType="Long">
        delete ol
        from order_link ol
        where ol.id = #{id}
          and not exists (
              select 1
              from order_info oi
              where oi.link_id = ol.id
                and oi.status = '1'
          )
    </delete>

    <delete id="deleteOrderLinkByIds" parameterType="String">
        delete ol
        from order_link ol
        where ol.id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
          and not exists (
              select 1
              from order_info oi
              where oi.link_id = ol.id
                and oi.status = '1'
          )
    </delete>
</mapper>
