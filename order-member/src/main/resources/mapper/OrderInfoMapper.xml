<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.member.mapper.OrderInfoMapper">
    
    <resultMap type="com.order.member.domain.OrderInfo" id="OrderInfoResult">
        <result property="id"    column="id"    />
        <result property="orderNumber"    column="order_number"    />
        <result property="userId"    column="user_id"    />
        <result property="type"    column="type"    />
        <result property="orderCount"    column="order_count"    />
        <result property="amount"    column="amount"    />
        <result property="rebatePercentage"    column="rebate_percentage"    />
        <result property="rebate"    column="rebate"    />
        <result property="upperRebatePercentage"    column="upper_rebate_percentage"    />
        <result property="upperRebate"    column="upper_rebate"    />
        <result property="status"    column="status"    />
        <result property="expiryTime"    column="expiry_time"    />
        <result property="productId"    column="product_id"    />
        <result property="extraCommissionId"    column="extra_commission_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="remarks"    column="remarks"    />
        <result property="commentId"    column="comment_id"    />
        <result property="linkId"    column="link_id"    />
        <!-- added user and product fields -->
        <result property="username" column="username" />
        <result property="productImage" column="product_image" />
        <result property="productTitle" column="product_title" />
    </resultMap>

    <sql id="selectOrderInfoVo">
        <!-- select from order_info (oi) and left join order_user (ou) and goods (g) -->
        select
            oi.id,
            oi.order_number,
            oi.user_id,
            oi.type,
            oi.order_count,
            oi.amount,
            oi.rebate_percentage,
            oi.rebate,
            oi.upper_rebate_percentage,
            oi.upper_rebate,
            oi.status,
            oi.expiry_time,
            oi.product_id,
            oi.extra_commission_id,
            oi.create_time,
            oi.remarks,
            oi.comment_id,
            oi.link_id,
            ou.username as username,
            COALESCE(oi.product_image, g.image) as product_image,
            COALESCE(oi.product_title, g.title) as product_title
        from order_info oi
        left join order_user ou on oi.user_id = ou.id
        left join goods g on oi.product_id = g.id
    </sql>

    <select id="selectOrderInfoList" parameterType="com.order.member.domain.OrderInfo" resultMap="OrderInfoResult">
        <include refid="selectOrderInfoVo"/>
        <where>  
            <if test="orderNumber != null  and orderNumber != ''"> and oi.order_number = #{orderNumber}</if>
            <if test="userId != null "> and oi.user_id = #{userId}</if>
            <if test="username != null "> and ou.username = #{username}</if>
            <if test="type != null  and type != ''"> and oi.type = #{type}</if>
            <if test="orderCount != null "> and oi.order_count = #{orderCount}</if>
            <if test="amount != null "> and oi.amount = #{amount}</if>
            <if test="status != null and status != ''"> and oi.status = #{status}</if>
        </where>
        order by oi.create_time desc
    </select>
    
    <select id="selectOrderInfoById" parameterType="Long" resultMap="OrderInfoResult">
        <include refid="selectOrderInfoVo"/>
        where oi.id = #{id}
    </select>

    <select id="hasOpenOrders" parameterType="Long" resultMap="OrderInfoResult">
        SELECT id, order_number, type, order_count, amount,
               rebate_percentage, rebate, status, expiry_time, product_id,
               create_time, product_image, product_title
        FROM order_info
        WHERE user_id = #{userId} AND status = '1'
        ORDER BY id DESC
        LIMIT 1
    </select>

    <select id="selectOwnedOrderForUpdate" resultMap="OrderInfoResult">
        SELECT id, order_number, type, amount, rebate, upper_rebate,
               status, link_id
        FROM order_info
        WHERE id = #{id} AND user_id = #{userId}
        FOR UPDATE
    </select>

    <select id="selectPublicOrderById" resultMap="OrderInfoResult">
        SELECT id, order_number, type, order_count, amount,
               rebate_percentage, rebate, status, expiry_time, product_id,
               create_time, product_image, product_title
        FROM order_info
        WHERE id = #{id} AND user_id = #{userId}
        LIMIT 1
    </select>

    <select id="selectPublicOrderInfoList" resultMap="OrderInfoResult">
        SELECT id, order_number, type, order_count, amount,
               rebate_percentage, rebate, status, expiry_time, product_id,
               create_time, product_image, product_title
        FROM order_info
        WHERE user_id = #{userId}
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        ORDER BY create_time DESC, id DESC
    </select>

    <insert id="insertOrderInfo" parameterType="com.order.member.domain.OrderInfo" useGeneratedKeys="true" keyProperty="id">
        insert into order_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNumber != null and orderNumber != ''">order_number,</if>
            <if test="userId != null">user_id,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="orderCount != null">order_count,</if>
            <if test="amount != null">amount,</if>
            <if test="rebatePercentage != null">rebate_percentage,</if>
            <if test="rebate != null">rebate,</if>
            <if test="upperRebatePercentage != null">upper_rebate_percentage,</if>
            <if test="upperRebate != null">upper_rebate,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="expiryTime != null">expiry_time,</if>
            <if test="productId != null">product_id,</if>
            <if test="extraCommissionId != null">extra_commission_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remarks != null">remarks,</if>
            <if test="commentId != null">comment_id,</if>
            <if test="linkId != null">link_id,</if>
            <if test="productImage != null">product_image,</if>
            <if test="productTitle != null">product_title,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNumber != null and orderNumber != ''">#{orderNumber},</if>
            <if test="userId != null">#{userId},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="orderCount != null">#{orderCount},</if>
            <if test="amount != null">#{amount},</if>
            <if test="rebatePercentage != null">#{rebatePercentage},</if>
            <if test="rebate != null">#{rebate},</if>
            <if test="upperRebatePercentage != null">#{upperRebatePercentage},</if>
            <if test="upperRebate != null">#{upperRebate},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="expiryTime != null">#{expiryTime},</if>
            <if test="productId != null">#{productId},</if>
            <if test="extraCommissionId != null">#{extraCommissionId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remarks != null">#{remarks},</if>
            <if test="commentId != null">#{commentId},</if>
            <if test="linkId != null">#{linkId},</if>
            <if test="productImage != null">#{productImage},</if>
            <if test="productTitle != null">#{productTitle},</if>
         </trim>
    </insert>

    <update id="updateOrderInfo" parameterType="com.order.member.domain.OrderInfo">
        UPDATE order_info
        SET remarks = #{remarks},
            comment_id = #{commentId}
        WHERE id = #{id}
    </update>

    <update id="transitionStatus">
        UPDATE order_info
        SET status = #{toStatus}
        WHERE id = #{id}
          AND user_id = #{userId}
          AND status = #{fromStatus}
    </update>

    <delete id="deleteOrderInfoById" parameterType="Long">
        delete from order_info
        where id = #{id}
          and 1 = 0
    </delete>

    <delete id="deleteOrderInfoByIds" parameterType="String">
        delete from order_info
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
          and 1 = 0
    </delete>
</mapper>
