<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.member.mapper.GoodsRechargeRecordMapper">
    
    <resultMap type="GoodsRechargeRecord" id="GoodsRechargeRecordResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="amount"    column="amount"    />
        <result property="withdrawalType"    column="withdrawal_type"    />
        <result property="giftAmount"    column="gift_amount"    />
        <result property="receivedAmount"    column="received_amount"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="remark"    column="remark"    />
        <result property="transactionType"    column="transaction_type"    />
        <result property="orderNumber"    column="order_number"    />
        <result property="isHidden"    column="is_hidden"    />
        <!-- 从 order_user 联表得到的额外字段 -->
        <result property="username" column="username" />
        <result property="phoneNumber" column="phone_number" />
        <result property="parentUsername" column="parent_username" />
    </resultMap>

    <sql id="selectGoodsRechargeRecordVo">
        select gr.id, gr.user_id, gr.amount, gr.withdrawal_type, gr.gift_amount,
               gr.received_amount, gr.status, gr.create_time, gr.remark, gr.transaction_type,
               gr.order_number, gr.is_hidden,
               -- 用户表字段
               ou.username as username, ou.phone_number as phone_number,
               pu.username as parent_username
        from goods_recharge_record gr
        left join order_user ou on gr.user_id = ou.id
        left join order_user pu on ou.parent_id = pu.id
    </sql>

    <select id="selectGoodsRechargeRecordList" parameterType="GoodsRechargeRecord" resultMap="GoodsRechargeRecordResult">
        <include refid="selectGoodsRechargeRecordVo"/>
        <where>  
            <if test="userId != null "> and gr.user_id = #{userId}</if>
            <if test="username != null "> and ou.username = #{username}</if>
            <if test="orderNumber != null  and orderNumber != ''"> and gr.order_number = #{orderNumber}</if>
        </where>
        order by gr.create_time desc
    </select>
    
    <select id="selectGoodsRechargeRecordById" parameterType="Long" resultMap="GoodsRechargeRecordResult">
        <include refid="selectGoodsRechargeRecordVo"/>
        where gr.id = #{id}
    </select>

    <insert id="insertGoodsRechargeRecord" parameterType="GoodsRechargeRecord" useGeneratedKeys="true" keyProperty="id">
        insert into goods_recharge_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="amount != null">amount,</if>
            <if test="withdrawalType != null and withdrawalType != ''">withdrawal_type,</if>
            <if test="giftAmount != null">gift_amount,</if>
            <if test="receivedAmount != null">received_amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
            <if test="transactionType != null and transactionType != ''">transaction_type,</if>
            <if test="orderNumber != null and orderNumber != ''">order_number,</if>
            <if test="isHidden != null">is_hidden,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="withdrawalType != null and withdrawalType != ''">#{withdrawalType},</if>
            <if test="giftAmount != null">#{giftAmount},</if>
            <if test="receivedAmount != null">#{receivedAmount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="transactionType != null and transactionType != ''">#{transactionType},</if>
            <if test="orderNumber != null and orderNumber != ''">#{orderNumber},</if>
            <if test="isHidden != null">#{isHidden},</if>
         </trim>
    </insert>

    <update id="updateGoodsRechargeRecord" parameterType="GoodsRechargeRecord">
        update goods_recharge_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="withdrawalType != null and withdrawalType != ''">withdrawal_type = #{withdrawalType},</if>
            <if test="giftAmount != null">gift_amount = #{giftAmount},</if>
            <if test="receivedAmount != null">received_amount = #{receivedAmount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="transactionType != null and transactionType != ''">transaction_type = #{transactionType},</if>
            <if test="orderNumber != null and orderNumber != ''">order_number = #{orderNumber},</if>
            <if test="isHidden != null">is_hidden = #{isHidden},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteGoodsRechargeRecordById" parameterType="Long">
        delete from goods_recharge_record where id = #{id}
    </delete>

    <delete id="deleteGoodsRechargeRecordByIds" parameterType="String">
        delete from goods_recharge_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
