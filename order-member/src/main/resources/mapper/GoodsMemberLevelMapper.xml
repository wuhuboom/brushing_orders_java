    <sql id="selectGoodsMemberLevelVo">
        select id, name, level, icon, price, min_balance, invite_count, order_count_per_day,
        min_commission_rate, max_commission_rate, min_continuous_commission_rate, max_continuous_commission_rate,
        task_count_per_day, withdraw_count_per_day, withdraw_fee_rate, min_withdraw_amount, withdraw_limit_per_day,
        min_withdraw, max_withdraw, description, create_time, product_match_enabled, product_match_min, product_match_max, translations_id from goods_member_level
    </sql>

    <select id="selectGoodsMemberLevelList" parameterType="GoodsMemberLevel" resultMap="GoodsMemberLevelResult">
        <include refid="selectGoodsMemberLevelVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="level != null "> and level = #{level}</if>
            <if test="icon != null  and icon != ''"> and icon = #{icon}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="minBalance != null "> and min_balance = #{minBalance}</if>
            <if test="inviteCount != null "> and invite_count = #{inviteCount}</if>
            <if test="orderCountPerDay != null "> and order_count_per_day = #{orderCountPerDay}</if>
            <if test="minCommissionRate != null "> and min_commission_rate = #{minCommissionRate}</if>
            <if test="maxCommissionRate != null "> and max_commission_rate = #{maxCommissionRate}</if>
            <if test="minContinuousCommissionRate != null "> and min_continuous_commission_rate = #{minContinuousCommissionRate}</if>
            <if test="maxContinuousCommissionRate != null "> and max_continuous_commission_rate = #{maxContinuousCommissionRate}</if>
            <if test="taskCountPerDay != null "> and task_count_per_day = #{taskCountPerDay}</if>
            <if test="withdrawCountPerDay != null "> and withdraw_count_per_day = #{withdrawCountPerDay}</if>
            <if test="withdrawFeeRate != null "> and withdraw_fee_rate = #{withdrawFeeRate}</if>
            <if test="minWithdrawAmount != null "> and min_withdraw_amount = #{minWithdrawAmount}</if>
            <if test="withdrawLimitPerDay != null "> and withdraw_limit_per_day = #{withdrawLimitPerDay}</if>
            <if test="minWithdraw != null "> and min_withdraw = #{minWithdraw}</if>
            <if test="maxWithdraw != null "> and max_withdraw = #{maxWithdraw}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="productMatchEnabled != null  and productMatchEnabled != ''"> and product_match_enabled = #{productMatchEnabled}</if>
            <if test="productMatchMin != null "> and product_match_min = #{productMatchMin}</if>
            <if test="productMatchMax != null "> and product_match_max = #{productMatchMax}</if>
            <if test="translationsId != null"> and translations_id = #{translationsId}</if>
        </where>
        order by level asc, id asc
    </select>

    <select id="selectGoodsMemberLevelById" parameterType="Long" resultMap="GoodsMemberLevelResult">
        <include refid="selectGoodsMemberLevelVo"/>
        where id = #{id}
    </select>

    <select id="selectLowestPriceLevel" resultMap="GoodsMemberLevelResult">
        <include refid="selectGoodsMemberLevelVo"/>
        order by price asc
        limit 1
    </select>

    <insert id="insertGoodsMemberLevel" parameterType="GoodsMemberLevel" useGeneratedKeys="true" keyProperty="id">
