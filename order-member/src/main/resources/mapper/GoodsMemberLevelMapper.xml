            <if test="productMatchMin != null">product_match_min,</if>
            <if test="productMatchMax != null">product_match_max,</if>
            <if test="translationsId != null">translations_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
