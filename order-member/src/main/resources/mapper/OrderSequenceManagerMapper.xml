<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.member.mapper.OrderSequenceManagerMapper">
    
    <resultMap type="OrderSequenceManager" id="OrderSequenceManagerResult">
        <result property="id"    column="id"    />
        <result property="seqType"    column="seq_type"    />
        <result property="seqDate"    column="seq_date"    />
        <result property="seqTime"    column="seq_time"    />
        <result property="currentSeq"    column="current_seq"    />
        <result property="version"    column="version"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectOrderSequenceManagerVo">
        select id, seq_type, seq_date, seq_time, current_seq, version, create_time, update_time from order_sequence_manager
    </sql>

    <select id="selectOrderSequenceManagerList" parameterType="OrderSequenceManager" resultMap="OrderSequenceManagerResult">
        <include refid="selectOrderSequenceManagerVo"/>
        <where>  
            <if test="seqType != null  and seqType != ''"> and seq_type = #{seqType}</if>
            <if test="seqDate != null  and seqDate != ''"> and seq_date = #{seqDate}</if>
            <if test="seqTime != null  and seqTime != ''"> and seq_time = #{seqTime}</if>
            <if test="currentSeq != null "> and current_seq = #{currentSeq}</if>
            <if test="version != null "> and version = #{version}</if>
        </where>
    </select>
    
    <select id="selectOrderSequenceManagerById" parameterType="Long" resultMap="OrderSequenceManagerResult">
        <include refid="selectOrderSequenceManagerVo"/>
        where id = #{id}
    </select>

    <select id="getCurrentSeq" resultMap="OrderSequenceManagerResult">
        <include refid="selectOrderSequenceManagerVo"/>
        WHERE seq_type = #{seqType}
        AND seq_date = #{seqDate}
        AND seq_time = #{seqTime}
        LIMIT 1
    </select>

    <!-- select for update -->
    <select id="getCurrentSeqForUpdate" resultMap="OrderSequenceManagerResult" parameterType="map">
        SELECT id, seq_type, seq_date, seq_time, current_seq, version, create_time, update_time
        FROM order_sequence_manager
        WHERE seq_type = #{seqType} AND seq_date = #{seqDate} AND seq_time = #{seqTime}
        FOR UPDATE
    </select>

    <insert id="insertOrderSequenceManager" parameterType="OrderSequenceManager" useGeneratedKeys="true" keyProperty="id">
        insert into order_sequence_manager
        <trim prefix="(" suffix=")" suffixOverrides="," >
            <if test="seqType != null and seqType != ''">seq_type,</if>
            <if test="seqDate != null and seqDate != ''">seq_date,</if>
            <if test="seqTime != null and seqTime != ''">seq_time,</if>
            <if test="currentSeq != null">current_seq,</if>
            <if test="version != null">version,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides="," >
            <if test="seqType != null and seqType != ''">#{seqType},</if>
            <if test="seqDate != null and seqDate != ''">#{seqDate},</if>
            <if test="seqTime != null and seqTime != ''">#{seqTime},</if>
            <if test="currentSeq != null">#{currentSeq},</if>
            <if test="version != null">#{version},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="incrementWithVersion" parameterType="OrderSequenceManager">
        update order_sequence_manager
        <trim prefix="SET" suffixOverrides=",">
            <if test="seqType != null and seqType != ''">seq_type = #{seqType},</if>
            <if test="seqDate != null and seqDate != ''">seq_date = #{seqDate},</if>
            <if test="seqTime != null and seqTime != ''">seq_time = #{seqTime},</if>
            <if test="currentSeq != null">current_seq = #{currentSeq},</if>
            <if test="version != null">version = version + 1,</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}  AND version = #{version}
    </update>

    <update id="updateCurrentSeqById" parameterType="OrderSequenceManager">
        update order_sequence_manager
        set current_seq = #{currentSeq}, update_time = #{updateTime}
        where id = #{id}
    </update>

    <update id="incrementByKey" parameterType="map">
        update order_sequence_manager set current_seq = current_seq + 1, update_time = #{updateTime}
        where seq_type = #{seqType} and seq_date = #{seqDate} and seq_time = #{seqTime}
    </update>

    <!-- keep atomic upsert if DB supports it -->
    <select id="getAndIncrementAtomic" resultType="java.lang.Long" statementType="STATEMENT">
        <![CDATA[
        INSERT INTO order_sequence_manager (seq_type, seq_date, seq_time, current_seq, version, create_time, update_time)
        VALUES ('${seqType}', '${seqDate}', '${seqTime}', 1, 0, NOW(), NOW())
        ON DUPLICATE KEY UPDATE current_seq = current_seq + 1, update_time = NOW(), current_seq = LAST_INSERT_ID(current_seq);
        SELECT LAST_INSERT_ID();
        ]]>
    </select>

    <delete id="deleteOrderSequenceManagerById" parameterType="Long">
        delete from order_sequence_manager where id = #{id}
    </delete>

    <delete id="deleteOrderSequenceManagerByIds" parameterType="String">
        delete from order_sequence_manager where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
