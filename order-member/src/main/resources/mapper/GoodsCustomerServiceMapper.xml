<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.member.mapper.GoodsCustomerServiceMapper">
    
    <resultMap type="GoodsCustomerService" id="GoodsCustomerServiceResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="image"    column="image"    />
        <result property="isEnabled"    column="is_enabled"    />
        <result property="link"    column="link"    />
        <result property="remarks"    column="remarks"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="translationsId" column="translations_id" />
    </resultMap>

    <sql id="selectGoodsCustomerServiceVo">
        select id, name, sort_order, image, is_enabled, link, remarks, create_by, create_time, translations_id from goods_customer_service
    </sql>

    <select id="selectGoodsCustomerServiceList" parameterType="GoodsCustomerService" resultMap="GoodsCustomerServiceResult">
        <include refid="selectGoodsCustomerServiceVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="sortOrder != null "> and sort_order = #{sortOrder}</if>
            <if test="image != null  and image != ''"> and image = #{image}</if>
            <if test="isEnabled != null  and isEnabled != ''"> and is_enabled = #{isEnabled}</if>
            <if test="link != null  and link != ''"> and link = #{link}</if>
            <if test="remarks != null  and remarks != ''"> and remarks = #{remarks}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and date(create_time) &gt;= #{params.beginTime}</if>
            <if test="params.endTime != null and params.endTime != ''"> and date(create_time) &lt;= #{params.endTime}</if>
        </where>
        order by sort_order asc, id asc
    </select>
    
    <select id="selectGoodsCustomerServiceById" parameterType="String" resultMap="GoodsCustomerServiceResult">
        <include refid="selectGoodsCustomerServiceVo"/>
        where id = #{id}
    </select>

    <insert id="insertGoodsCustomerService" parameterType="GoodsCustomerService" useGeneratedKeys="true" keyProperty="id">
        insert into goods_customer_service
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="image != null and image != ''">image,</if>
            <if test="isEnabled != null and isEnabled != ''">is_enabled,</if>
            <if test="link != null">link,</if>
            <if test="remarks != null">remarks,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="translationsId != null">translations_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="image != null and image != ''">#{image},</if>
            <if test="isEnabled != null and isEnabled != ''">#{isEnabled},</if>
            <if test="link != null">#{link},</if>
            <if test="remarks != null">#{remarks},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="translationsId != null">#{translationsId},</if>
         </trim>
    </insert>

    <update id="updateGoodsCustomerService" parameterType="GoodsCustomerService">
        update goods_customer_service
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="image != null and image != ''">image = #{image},</if>
            <if test="isEnabled != null and isEnabled != ''">is_enabled = #{isEnabled},</if>
            <if test="link != null">link = #{link},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="translationsId != null">translations_id = #{translationsId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteGoodsCustomerServiceById" parameterType="String">
        delete from goods_customer_service where id = #{id}
    </delete>

    <delete id="deleteGoodsCustomerServiceByIds" parameterType="String">
        delete from goods_customer_service where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
