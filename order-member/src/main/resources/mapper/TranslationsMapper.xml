            <if test="ruRu != null  and ruRu != ''"> and ru_RU = #{ruRu}</if>
            <if test="huHu != null  and huHu != ''"> and hu_HU = #{huHu}</if>
            <if test="plPl != null  and plPl != ''"> and pl_PL = #{plPl}</if>
            <if test="skSk != null  and skSk != ''"> and sk_SK = #{skSk}</if>
            <if test="frFr != null  and frFr != ''"> and fr_FR = #{frFr}</if>
            <if test="csCz != null  and csCz != ''"> and cs_CZ = #{csCz}</if>
            <if test="ptBr != null  and ptBr != ''"> and pt_BR = #{ptBr}</if>
            <if test="hiIn != null  and hiIn != ''"> and hi_IN = #{hiIn}</if>
        </where>
    </select>
    
    <select id="selectTranslationsById" parameterType="Long" resultMap="TranslationsResult">
        <include refid="selectTranslationsVo"/>
        where id = #{id}
    </select>

    <select id="selectTranslationsByIds" resultMap="TranslationsResult">
        <include refid="selectTranslationsVo"/>
        where id in
        <foreach item="id" collection="list" open="(" separator="," close=")">
            #{id}
