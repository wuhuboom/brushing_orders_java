    <sql id="selectTranslationsVo">
        select id, zh_CN, zh_TW, ko_KR, th_TH, ja_JP, pt_PT, en_US, ar_SA, es_ES, sv_SE,
        it_IT, de_DE, no_NO, ru_RU, hu_HU, pl_PL, sk_SK, fr_FR, cs_CZ, pt_BR, hi_IN from translations
    </sql>

    <select id="selectTranslationsList" parameterType="com.order.common.i18n.Translations" resultMap="TranslationsResult">
        <include refid="selectTranslationsVo"/>
        <where>  
            <if test="zhCn != null  and zhCn != ''"> and zh_CN = #{zhCn}</if>
            <if test="zhTw != null  and zhTw != ''"> and zh_TW = #{zhTw}</if>
            <if test="koKr != null  and koKr != ''"> and ko_KR = #{koKr}</if>
            <if test="thTh != null  and thTh != ''"> and th_TH = #{thTh}</if>
            <if test="jaJp != null  and jaJp != ''"> and ja_JP = #{jaJp}</if>
            <if test="ptPt != null  and ptPt != ''"> and pt_PT = #{ptPt}</if>
            <if test="enUs != null  and enUs != ''"> and en_US = #{enUs}</if>
            <if test="arSa != null  and arSa != ''"> and ar_SA = #{arSa}</if>
