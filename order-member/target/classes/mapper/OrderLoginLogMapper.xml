<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.member.mapper.OrderLoginLogMapper">
    
    <resultMap type="OrderLoginLog" id="OrderLoginLogResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="ip"    column="ip"    />
        <!-- 来自 order_user 的用户名 -->
        <result property="username" column="username" />
        <result property="address"    column="address"    />
        <result property="createTime"    column="create_time"    />
        <result property="loginParams"    column="login_params"    />
    </resultMap>

    <sql id="selectOrderLoginLogVo">
        select oll.id, oll.user_id, oll.ip, oll.address, oll.create_time, oll.login_params,
               ou.username as username
        from order_login_log oll
        left join order_user ou on oll.user_id = ou.id
    </sql>

    <select id="selectOrderLoginLogList" parameterType="OrderLoginLog" resultMap="OrderLoginLogResult">
        <include refid="selectOrderLoginLogVo"/>
        <where>  
            <if test="userId != null "> and oll.user_id = #{userId}</if>
            <if test="ip != null  and ip != ''"> and oll.ip = #{ip}</if>
            <if test="username != null  and username != ''"> and ou.username = #{username}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectOrderLoginLogById" parameterType="Long" resultMap="OrderLoginLogResult">
        <include refid="selectOrderLoginLogVo"/>
        where id = #{id}
    </select>

    <insert id="insertOrderLoginLog" parameterType="OrderLoginLog" useGeneratedKeys="true" keyProperty="id">
        insert into order_login_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="ip != null and ip != ''">ip,</if>
            <if test="address != null and address != ''">address,</if>
            <if test="createTime != null">create_time,</if>
            <if test="loginParams != null">login_params,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="ip != null and ip != ''">#{ip},</if>
            <if test="address != null and address != ''">#{address},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="loginParams != null">#{loginParams},</if>
         </trim>
    </insert>

    <update id="updateOrderLoginLog" parameterType="OrderLoginLog">
        update order_login_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="ip != null and ip != ''">ip = #{ip},</if>
            <if test="address != null and address != ''">address = #{address},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="loginParams != null">login_params = #{loginParams},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderLoginLogById" parameterType="Long">
        delete from order_login_log where id = #{id}
    </delete>

    <delete id="deleteOrderLoginLogByIds" parameterType="String">
        delete from order_login_log where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
