<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.member.mapper.GoodsMapper">
    
    <resultMap type="Goods" id="GoodsResult">
        <result property="id"    column="id"    />
        <result property="title"    column="title"    />
        <result property="typeId"    column="type_id"    />
        <result property="typeTitle"    column="typeTitle"    />
        <result property="isEnabled"    column="is_enabled"    />
        <result property="price"    column="price"    />
        <result property="serialNumber"    column="serial_number"    />
        <result property="image"    column="image"    />
        <result property="subTitle"    column="sub_title"    />
        <result property="unitPrice"    column="unit_price"    />
        <result property="quantity"    column="quantity"    />
        <result property="starRating"    column="star_rating"    />
        <result property="rating"    column="rating"    />
        <result property="description"    column="description"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectGoodsVo">
        select
        g.id,
        g.title,
        g.type_id,
        gt.title as typeTitle,
        g.is_enabled,
        g.price,
        g.serial_number,
        g.image,
        g.sub_title,
        g.unit_price,
        g.quantity,
        g.star_rating,
        g.rating,
        g.description,
        g.create_by,
        g.create_time
        from goods  g
        left join goods_type gt on g.type_id = gt.id
    </sql>



    <select id="selectGoodsList" parameterType="Goods" resultMap="GoodsResult">
        <include refid="selectGoodsVo"/>
        <where>  
            <if test="title != null  and title != ''"> and g.title = #{title}</if>
            <if test="isEnabled != null  and isEnabled != ''"> and g.is_enabled = #{isEnabled}</if>
        </where>
    </select>
    
    <select id="selectGoodsById" parameterType="Long" resultMap="GoodsResult">
        <include refid="selectGoodsVo"/>
        where g.id = #{id}
    </select>

    <select id="selectNearestPriceGoods" parameterType="java.math.BigDecimal" resultMap="GoodsResult">
        select
            g.id,
            g.title,
            g.type_id,
            gt.title as typeTitle,
            g.is_enabled,
            g.price,
            g.serial_number,
            g.image,
            g.sub_title,
            g.unit_price,
            g.quantity,
            g.star_rating,
            g.rating,
            g.description,
            g.create_by,
            g.create_time
        from goods  g
        left join goods_type gt on g.type_id = gt.id
        WHERE
            g.price &lt;= #{price}
        ORDER BY
            g.price DESC
            LIMIT 1
    </select>

    <select id="selectRandomGoods" resultMap="GoodsResult">
        select
            g.id,
            g.title,
            g.type_id,
            g.is_enabled,
            g.price,
            g.serial_number,
            g.image,
            g.sub_title,
            g.unit_price,
            g.quantity,
            g.star_rating,
            g.rating,
            g.description,
            g.create_by,
            g.create_time
        from goods  g
        WHERE g.id >= (
            SELECT FLOOR(RAND() * (SELECT MAX(id) FROM goods))
        )
            LIMIT 8
    </select>

    <insert id="insertGoods" parameterType="Goods" useGeneratedKeys="true" keyProperty="id">
        insert into goods
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="typeId != null">type_id,</if>
            <if test="isEnabled != null and isEnabled != ''">is_enabled,</if>
            <if test="price != null">price,</if>
            <if test="serialNumber != null">serial_number,</if>
            <if test="image != null and image != ''">image,</if>
            <if test="subTitle != null">sub_title,</if>
            <if test="unitPrice != null">unit_price,</if>
            <if test="quantity != null">quantity,</if>
            <if test="starRating != null">star_rating,</if>
            <if test="rating != null">rating,</if>
            <if test="description != null">description,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="typeId != null">#{typeId},</if>
            <if test="isEnabled != null and isEnabled != ''">#{isEnabled},</if>
            <if test="price != null">#{price},</if>
            <if test="serialNumber != null">#{serialNumber},</if>
            <if test="image != null and image != ''">#{image},</if>
            <if test="subTitle != null">#{subTitle},</if>
            <if test="unitPrice != null">#{unitPrice},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="starRating != null">#{starRating},</if>
            <if test="rating != null">#{rating},</if>
            <if test="description != null">#{description},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateGoods" parameterType="Goods">
        update goods
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="typeId != null">type_id = #{typeId},</if>
            <if test="isEnabled != null and isEnabled != ''">is_enabled = #{isEnabled},</if>
            <if test="price != null">price = #{price},</if>
            <if test="serialNumber != null">serial_number = #{serialNumber},</if>
            <if test="image != null and image != ''">image = #{image},</if>
            <if test="subTitle != null">sub_title = #{subTitle},</if>
            <if test="unitPrice != null">unit_price = #{unitPrice},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="starRating != null">star_rating = #{starRating},</if>
            <if test="rating != null">rating = #{rating},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteGoodsById" parameterType="Long">
        delete from goods where id = #{id}
    </delete>

    <delete id="deleteGoodsByIds" parameterType="String">
        delete from goods where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
