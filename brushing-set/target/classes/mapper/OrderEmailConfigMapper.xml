<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brushing.set.mapper.OrderEmailConfigMapper">
    
    <resultMap type="OrderEmailConfig" id="OrderEmailConfigResult">
        <result property="id"    column="id"    />
        <result property="host"    column="host"    />
        <result property="username"    column="username"    />
        <result property="password"    column="password"    />
        <result property="fromAddress"    column="from_address"    />
        <result property="fromName"    column="from_name"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectOrderEmailConfigVo">
        select id, host, username, password, from_address, from_name, create_time, update_time from order_email_config
    </sql>

    <select id="selectOrderEmailConfigList" parameterType="OrderEmailConfig" resultMap="OrderEmailConfigResult">
        <include refid="selectOrderEmailConfigVo"/>
        <where>  
            <if test="host != null  and host != ''"> and host = #{host}</if>
            <if test="username != null  and username != ''"> and username like concat('%', #{username}, '%')</if>
            <if test="password != null  and password != ''"> and password = #{password}</if>
            <if test="fromAddress != null  and fromAddress != ''"> and from_address = #{fromAddress}</if>
            <if test="fromName != null  and fromName != ''"> and from_name like concat('%', #{fromName}, '%')</if>
        </where>
    </select>
    
    <select id="selectOrderEmailConfigById" parameterType="Long" resultMap="OrderEmailConfigResult">
        <include refid="selectOrderEmailConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertOrderEmailConfig" parameterType="OrderEmailConfig" useGeneratedKeys="true" keyProperty="id">
        insert into order_email_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="host != null and host != ''">host,</if>
            <if test="username != null and username != ''">username,</if>
            <if test="password != null and password != ''">password,</if>
            <if test="fromAddress != null and fromAddress != ''">from_address,</if>
            <if test="fromName != null">from_name,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="host != null and host != ''">#{host},</if>
            <if test="username != null and username != ''">#{username},</if>
            <if test="password != null and password != ''">#{password},</if>
            <if test="fromAddress != null and fromAddress != ''">#{fromAddress},</if>
            <if test="fromName != null">#{fromName},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateOrderEmailConfig" parameterType="OrderEmailConfig">
        update order_email_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="host != null and host != ''">host = #{host},</if>
            <if test="username != null and username != ''">username = #{username},</if>
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="fromAddress != null and fromAddress != ''">from_address = #{fromAddress},</if>
            <if test="fromName != null">from_name = #{fromName},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderEmailConfigById" parameterType="Long">
        delete from order_email_config where id = #{id}
    </delete>

    <delete id="deleteOrderEmailConfigByIds" parameterType="String">
        delete from order_email_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
